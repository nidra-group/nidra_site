# ─────────────────────────────────────────────────────────────────────────────
# OBLIGATORIAS: sin estas el build falla. Es deliberado — es preferible no
# poder desplegar a publicar un sitio que parece sano y no lo está.
# ─────────────────────────────────────────────────────────────────────────────

# Dominio público. Se usa en canónicas, sitemap y metadatos sociales.
NEXT_PUBLIC_SITE_URL=https://nidra.cloud

# Clave que firma la marca temporal anti-bot del formulario.
# Generar con: openssl rand -hex 32
FORM_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# OPCIONALES: si faltan, la interfaz se adapta. Ninguna se rellena con un
# valor por defecto: un destino plausible pero inexistente publica un 404 en
# silencio, que es peor que la ausencia del enlace.
# ─────────────────────────────────────────────────────────────────────────────

# Página de agenda (Cal.com o equivalente conectado a Google Calendar).
# Sin esta variable, la reserva NO se ofrece en ninguna parte del sitio.
# NEXT_PUBLIC_BOOKING_URL=https://cal.com/nidra/30min

# Subdominio del espacio profesional del fundador.
# Sin esta variable, el perfil se sirve dentro del sitio, en /es/cv.
# NEXT_PUBLIC_PROFILE_URL=https://jmujica.nidra.cloud

# Asistente conversacional, desarrollado fuera de este proyecto.
# Sin esta variable el sitio funciona igual: el widget no se monta.
# NEXT_PUBLIC_CHAT_EMBED_URL=

# ─────────────────────────────────────────────────────────────────────────────
# ENTREGA DEL FORMULARIO
# Sin estas, el formulario informa que el canal no está disponible y ofrece el
# correo directo, en vez de romper el build.
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
CONTACT_INBOX=jmujica@nidra.cloud
